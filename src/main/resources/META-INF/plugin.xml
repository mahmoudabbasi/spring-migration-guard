
<idea-plugin>
    <id>com.bammwise.springboot.compatibility</id>
    <name>Spring Migration Guard</name>
    <vendor>Bammwise</vendor>

    <description><![CDATA[
        Detect Spring Boot and Java versions, analyze dependency compatibility,
        recommend compatible versions, and preview changes before applying them.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>org.jetbrains.idea.maven</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow
                id="Spring Migration Guard"
                anchor="bottom"
                factoryClass="com.bammwise.ui.MigrationGuardToolWindowFactory"/>
    </extensions>

    <actions>
        <action
                id="com.bammwise.migrationguard.AnalyzeProjectAction"
                class="com.bammwise.action.CheckCompatibilityAction"
                text="Analyze Spring Boot Compatibility"
                description="Analyze dependencies and recommend compatible versions">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
